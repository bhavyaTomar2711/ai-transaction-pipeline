# ═══════════════════════════════════════════════════════════════════════════
# AI Transaction Pipeline — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# 
# For Local Development (Docker Compose): Use defaults below
# For Supabase Production: Replace DATABASE_URL with your Supabase connection string

# ─────────────────────────────────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────────────────────────────────
# Local (Docker): postgresql://postgres:postgres@postgres:5432/transactions_db
# Supabase: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/transactions_db

# ─────────────────────────────────────────────────────────────────────────
# Redis Configuration
# ─────────────────────────────────────────────────────────────────────────
# Local (Docker): redis://redis:6379/0
# Cloud: redis://:password@host:port/0
REDIS_URL=redis://redis:6379/0

# ─────────────────────────────────────────────────────────────────────────
# Groq API Configuration (Optional)
# ─────────────────────────────────────────────────────────────────────────
# Get key from: https://console.groq.com/keys
# Without this, pipeline uses rule-based fallbacks
GROQ_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Application Settings
# ─────────────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
LLM_BATCH_SIZE=10
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=2.0
ANOMALY_MULTIPLIER=3.0
